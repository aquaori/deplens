# Agent API 配置，推荐 Qwen API，或其他符合 OpenAI API 规范的 API 接口
# 全局安装时更推荐使用 `deplens config set apiKey|baseUrl|model ...`
# 当前文件仍可作为项目级覆盖配置
QWEN_API_KEY=your-own-api-key
QWEN_BASE_URL=your-own-base-url
QWEN_MODEL=qwen-plus

# Optional experimental Jev decision provider (agent.review.provider = "jev")
TYPESAFE_API_KEY=your-own-typesafe-key
# JEV_API_KEY is also accepted; TYPESAFE_API_KEY takes precedence
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
